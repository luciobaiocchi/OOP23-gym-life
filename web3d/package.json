{
  "name": "gym-life-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Gym Life 3D - versione browser del gioco, con Three.js e musica procedurale",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=game.js --watch --servedir=. --serve=8080"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
